{
    "controller_type": "vive_controller",
    "name": "Gesture Manager Pro vive_controller",
    "description": "Pro simulator actions. Customize in SteamVR bindings.",
    "bindings": {
        "/actions/pro": {
            "sources": [
                {
                    "path": "/user/hand/left/input/trackpad",
                    "mode": "trackpad",
                    "inputs": {
                        "position": {
                            "output": "/actions/pro/in/move"
                        }
                    }
                },
                {
                    "path": "/user/hand/left/input/trigger",
                    "mode": "trigger",
                    "inputs": {
                        "pull": {
                            "output": "/actions/pro/in/left_trigger"
                        }
                    }
                },
                {
                    "path": "/user/hand/left/input/grip",
                    "mode": "button",
                    "inputs": {
                        "click": {
                            "output": "/actions/pro/in/left_grip_button"
                        }
                    }
                },
                {
                    "path": "/user/hand/left/input/trackpad",
                    "mode": "button",
                    "inputs": {
                        "touch": {
                            "output": "/actions/pro/in/left_thumb_touch"
                        }
                    }
                },
                {
                    "path": "/user/hand/left/input/trackpad",
                    "mode": "button",
                    "inputs": {
                        "click": {
                            "output": "/actions/pro/in/sprint"
                        }
                    }
                },
                {
                    "path": "/user/hand/right/input/trackpad",
                    "mode": "trackpad",
                    "inputs": {
                        "position": {
                            "output": "/actions/pro/in/turn"
                        }
                    }
                },
                {
                    "path": "/user/hand/right/input/trigger",
                    "mode": "trigger",
                    "inputs": {
                        "pull": {
                            "output": "/actions/pro/in/right_trigger"
                        }
                    }
                },
                {
                    "path": "/user/hand/right/input/grip",
                    "mode": "button",
                    "inputs": {
                        "click": {
                            "output": "/actions/pro/in/right_grip_button"
                        }
                    }
                },
                {
                    "path": "/user/hand/right/input/trackpad",
                    "mode": "button",
                    "inputs": {
                        "touch": {
                            "output": "/actions/pro/in/right_thumb_touch"
                        }
                    }
                },
                {
                    "path": "/user/hand/right/input/trackpad",
                    "mode": "trackpad",
                    "inputs": {
                        "position": {
                            "output": "/actions/pro/in/menu_axis"
                        }
                    }
                },
                {
                    "path": "/user/hand/right/input/trigger",
                    "mode": "button",
                    "inputs": {
                        "click": {
                            "output": "/actions/pro/in/select"
                        }
                    }
                },
                {
                    "path": "/user/hand/left/input/application_menu",
                    "mode": "button",
                    "inputs": {
                        "click": {
                            "output": "/actions/pro/in/menu"
                        }
                    }
                },
                {
                    "path": "/user/hand/right/input/application_menu",
                    "mode": "button",
                    "inputs": {
                        "click": {
                            "output": "/actions/pro/in/back"
                        }
                    }
                },
                {
                    "path": "/user/hand/right/input/trackpad",
                    "mode": "button",
                    "inputs": {
                        "click": {
                            "output": "/actions/pro/in/jump"
                        }
                    }
                }
            ],
            "poses": [
                {
                    "path": "/user/hand/left/pose/raw",
                    "output": "/actions/pro/in/left_pose"
                },
                {
                    "path": "/user/hand/right/pose/raw",
                    "output": "/actions/pro/in/right_pose"
                }
            ],
            "chords": []
        }
    },
    "options": {},
    "simulated_actions": []
}
