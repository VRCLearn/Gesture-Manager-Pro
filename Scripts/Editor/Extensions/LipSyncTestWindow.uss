.test-root {
    padding: 12px;
}

.title {
    -unity-font-style: bold;
    font-size: 14px;
    margin-top: 8px;
    margin-bottom: 8px;
}

.description {
    white-space: normal;
    margin-bottom: 8px;
}

.section {
    margin-top: 12px;
    margin-bottom: 12px;
}

.actions {
    flex-direction: row;
    margin-bottom: 8px;
}

.actions > Button {
    flex-grow: 1;
}

.hidden {
    display: none;
}

.score {
    margin-top: 3px;
    margin-bottom: 3px;
}
